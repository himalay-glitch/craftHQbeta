---
import AppLayout from "@/layouts/AppLayout.astro";
import { Dashboard } from "@/components/dashboard/Dashboard";
import { dashboardData } from "./_sample-data";

// The top bar's search gets a slim list; it's a separate island and can't share the dashboard's state.
const search = dashboardData.stories.map(({ id, title, status }) => ({ id, title, status }));
---

<AppLayout title="Dashboard · CraftHQ" viewer={dashboardData.viewer} search={search}>
  <Dashboard client:load data={dashboardData} />
</AppLayout>
