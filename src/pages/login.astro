---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LoginIntro from "@/components/LoginIntro.astro";
import { LoginForm } from "@/components/LoginForm";
import { RebusBot, type RebusBotItem } from "@/components/RebusBot";

// The Builder bot (coral plush, yellow safety helmet, round glasses), rendered in Blender
// (design/blender/crafthq_bots_v001.blend). Idle loop; its "working" loop plays on hover.
const team: RebusBotItem[] = [
  {
    key: "builder",
    role: "Builder · builds it",
    idle: "/videos/bots/builder-idle",
    work: "/videos/bots/builder-work",
    poster: "/images/bots/builder.webp",
  },
];
---

<BaseLayout>
  {/* First, so its gate runs before the page paints (DESIGN.md §8.8). */}
  <LoginIntro />
  <div class="flex min-h-dvh flex-col bg-background">
    <header class="flex h-16 flex-none items-center justify-between px-5 sm:px-8" data-intro-fade="3">
      {/* The black-glass wordmark with the red glass slash (design/blender/crafthq_logo_glass_v002.blend), the same files and 22 px height as the dashboard's top bar. */}
      <img
        src="/dashboard/crafthq-logo-44.webp"
        srcset="/dashboard/crafthq-logo-22.webp 1x, /dashboard/crafthq-logo-44.webp 2x, /dashboard/crafthq-logo-66.webp 3x"
        width={128}
        height={22}
        alt="CraftHQ"
        class="block h-[22px] w-auto"
      />
      <span class="text-[13px] text-muted-foreground">by BetaCraft</span>
    </header>

    {/* One vertical rhythm on an 8px scale: headline → 16 → subtitle → 32 → form */}
    <main class="flex flex-1 flex-col items-center justify-center px-5 pb-16">
      <div class="flex w-full max-w-[640px] flex-col items-center text-center">
        {/* Screen readers get the plain sentence; the visual line swaps the word "robot" for the bot. */}
        <h1 class="sr-only">Your robot build team, shipping 10× faster.</h1>
        <p aria-hidden="true" class="hero-title">
          <span class="block">
            <span data-intro-fade="1">Your</span> <RebusBot client:load bots={team} /> <span data-intro-fade="1">build team,</span>
          </span>
          <span class="block" data-intro-fade="1">shipping 10× faster</span>
        </p>

        <p class="mt-4 text-[16px] leading-6 text-muted-foreground" data-intro-fade="2">Sign in to your build team</p>

        <div class="mt-8 w-full max-w-[400px]" data-intro-fade="3">
          <LoginForm client:load />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
