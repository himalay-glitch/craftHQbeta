---
// The signed-in app shell: the top bar and the page under it. Owned by the dashboard owner (CLAUDE.md).
// The design follows the Asana reference rather than DESIGN.md's sidebar (proposed in its own DESIGN.md PR).
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TopBar } from "@/components/shell/TopBar";
import tokens from "@/components/dashboard/tokens.module.css";
import type { SearchItem, Viewer } from "@/types/dashboard";

interface Props {
  title?: string;
  viewer: Viewer;
  search: SearchItem[];
}

const { title, viewer, search } = Astro.props;
---

<BaseLayout title={title}>
  <div class:list={[tokens.tokens, tokens.page, "min-h-dvh"]}>
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-white px-4 py-2 text-[14px] font-medium shadow-[var(--shadow-menu)] focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <TopBar client:load viewer={viewer} search={search} current={Astro.url.pathname} />
    <slot />
  </div>
</BaseLayout>
