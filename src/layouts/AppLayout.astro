---
// The signed-in app shell: the top bar, the sidebar and the page beside it. Owned by the dashboard owner
// (CLAUDE.md). The look follows the Asana reference: a full-width top bar with search and the account, and
// a sidebar with the main links (docs/design/dashboard-plan.md, §3).
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Sidebar } from "@/components/shell/Sidebar";
import { TopBar } from "@/components/shell/TopBar";
import tokens from "@/components/dashboard/tokens.module.css";
import type { SearchItem, Viewer } from "@/types/dashboard";
import { dashboardData } from "@/pages/dashboard/_sample-data";

interface Props {
  title?: string;
  viewer: Viewer;
  search: SearchItem[];
  /** The project this is, beside the logo. Until there's a session with the current project, the sample's. */
  project?: string;
}

const { title, viewer, search, project = dashboardData.project } = Astro.props;
---

<BaseLayout title={title}>
  {/* Before the shell paints: restore the opened sidebar if that's what this person chose (Sidebar.tsx). */}
  <script is:inline>
    try {
      if (localStorage.getItem("crafthq.sidebar") === "expanded") document.documentElement.dataset.sidebar = "expanded";
    } catch {}
  </script>
  {/* From 1024 px the app is a canvas with a sheet on it (DESIGN.md §3.4): the top bar and the sidebar are the canvas,
      and the page beside them is one sheet whose top-left corner curves where the two meet (Shubham, 26 Nov: the cards
      are rounded, so the frame shouldn't end in a sharp corner). Each page paints the sheet: white, or Ask PM's wash. */}
  {/* The canvas behind the sheet's corner is white, the sidebar's colour (Shubham, 26 Nov: the sidebar went white, the
      top bar stays grey), so the curve is cut out beside the sidebar and the top bar stays one straight band. Utilities,
      not the `.page` class: that class isn't in a CSS layer and would beat the `lg:` one. */}
  <div class:list={[tokens.tokens, "min-h-dvh bg-[var(--page)] text-[var(--tx)] lg:bg-white"]}>
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-white px-4 py-2 text-[14px] font-medium ring-1 ring-black/[0.08] focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <TopBar client:load viewer={viewer} search={search} current={Astro.url.pathname} project={project} />
    <div class="flex">
      {/* Plain links in the HTML; it hydrates when idle for its tooltips and the `[` toggle. */}
      <Sidebar client:idle current={Astro.url.pathname} />
      {/* `overflow-clip` (not hidden) rounds what the page paints without making a scroll box, so sticky parts still stick. */}
      {/* 40 px = the cards' 24 px corner + the 16 px gap around them, so the two curves run parallel (concentric). */}
      <div class="min-w-0 flex-1 lg:overflow-clip lg:rounded-tl-[40px] lg:bg-[var(--page)] lg:ring-1 lg:ring-black/[0.08]">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
