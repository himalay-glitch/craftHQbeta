# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env* covers .env, .env.local and .env.*.local; the template with placeholders is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
/.playwright-mcp/

# blender backups
*.blend1

# Blender frame sequences (re-render from design/blender/*.blend)
design/renders/**/frame_*.png

# personal Claude session notes stay local so they never conflict
SESSION_LOG*.md
